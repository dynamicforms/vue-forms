{
  "name": "@dynamicforms/vue-forms",
  "private": false,
  "version": "0.5.1",
  "type": "module",
  "description": "A lightweight Vue.js library for form state management with built-in validation, conditional logic, nested structures, and a rich event system. UI-agnostic and TypeScript-first.",
  "author": "Jure Erznožnik",
  "files": [
    "dist/*"
  ],
  "main": "dist/dynamicforms-vue-forms.umd.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/dynamicforms-vue-forms.umd.cjs",
      "import": "./dist/dynamicforms-vue-forms.js"
    }
  },
  "workspaces": [
    "docs"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run --coverage",
    "lint": "eslint src --fix && vue-tsc --noEmit",
    "docs:dev": "npm run docs:dev -w docs",
    "docs:build": "npm run docs:build -w docs",
    "docs:preview": "npm run docs:preview -w docs"
  },
  "keywords": [
    "vue",
    "vue3",
    "dynamicforms",
    "forms",
    "form-state",
    "form-management",
    "validation",
    "reactive",
    "typescript",
    "data entry"
  ],
  "license": "MIT",
  "homepage": "https://docs.velis.si/dynamicforms/vue-forms",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velis74/dynamicforms-vue-forms.git"
  },
  "bugs": {
    "url": "https://github.com/velis74/dynamicforms-vue-forms/issues"
  },
  "peerDependencies": {
    "lodash-es": "^4.17.12",
    "vue": "^3.4"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/markdown-it-attrs": "^4.1.3",
    "@types/node": "^24.5.2",
    "@vitejs/plugin-vue": "^6",
    "@vitest/coverage-v8": "^3",
    "@vue/test-utils": "^2.2.4",
    "@vue/tsconfig": "^0.7.0",
    "baseline-browser-mapping": "^2.8.31",
    "eslint-config-velis": "^2.0.11",
    "jsdom": "^26.0.0",
    "markdown-it-attrs": "^4.3.1",
    "rollup-plugin-visualizer": "^5.14.0",
    "typescript": "^5",
    "vite": "^7",
    "vite-plugin-dts": "^4",
    "vite-plugin-eslint": "^1.8.1",
    "vitest": "^3",
    "vue-markdown-render": "^2.3.0",
    "vue-tsc": "^2"
  }
}
