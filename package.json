{
  "name": "@dynamicforms/vue-forms",
  "private": false,
  "version": "0.18.0",
  "type": "module",
  "description": "A lightweight Vue.js library for form state management with built-in validation, conditional logic, nested structures, and a rich event system. UI-agnostic and TypeScript-first.",
  "author": "Jure Erzno\u017enik",
  "files": [
    "dist/*"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/dynamicforms-vue-forms.js"
    },
    "./style.css": "./dist/dynamicforms-vue-forms.css",
    "./package.json": "./package.json"
  },
  "workspaces": [
    "docs"
  ],
  "scripts": {
    "build": "vite build",
    "prepack": "npm run build",
    "test": "vitest run --coverage",
    "lint": "eslint src --fix && vue-tsc --noEmit",
    "lint:ci": "eslint src && vue-tsc --noEmit",
    "docs:dev": "npm run docs:dev -w docs",
    "docs:build": "npm run docs:build -w docs",
    "docs:preview": "npm run docs:preview -w docs"
  },
  "keywords": [
    "vue",
    "vue3",
    "dynamicforms",
    "forms",
    "form-state",
    "form-management",
    "validation",
    "reactive",
    "typescript",
    "data entry"
  ],
  "license": "MIT",
  "homepage": "https://docs.velis.si/dynamicforms/vue-forms",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dynamicforms/vue-forms.git"
  },
  "bugs": {
    "url": "https://github.com/dynamicforms/vue-forms/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@dynamicforms/translatable": "^0.1.0",
    "lodash-es": "^4.17.21"
  },
  "peerDependencies": {
    "vue": "^3.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/lodash-es": "^4.17.12",
    "@types/markdown-it-attrs": "^4.1.3",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-vue": "^6",
    "@vitest/coverage-v8": "^4",
    "@vue/test-utils": "^2.2.4",
    "@vue/tsconfig": "^0.7.0",
    "baseline-browser-mapping": "^2.8.31",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-velis": "^3.0.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unicorn": "^73.0.0",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^26.0.0",
    "markdown-it-attrs": "^4.3.1",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^5.14.0",
    "typescript": "^5",
    "vite": "^8",
    "vite-plugin-dts": "^4",
    "vitest": "^4",
    "vue-eslint-parser": "^10.4.1",
    "vue-markdown-render": "^2.3.0",
    "vue-tsc": "^2"
  }
}
